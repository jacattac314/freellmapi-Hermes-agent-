# Airtable — personal access token from https://airtable.com/account
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Airtable workspace ID — visible in the URL when you open a workspace:
# https://airtable.com/wsp<ID>/workspace/billing
AIRTABLE_WORKSPACE_ID=wspXXXXXXXXXXXXXX

# After running `npm run setup`, paste the created base ID here:
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Your zip code and coordinates for distance calculations
SEARCH_ZIP=10001
SEARCH_LAT=40.7484
SEARCH_LNG=-73.9967
SEARCH_RADIUS_MILES=300

# LLM for AI summaries — uses the local freellmapi router by default
LLM_BASE_URL=http://localhost:3001/v1
LLM_API_KEY=not-needed
LLM_MODEL=smart

# Alert email (optional — leave blank to disable email alerts)
ALERT_EMAIL_TO=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
