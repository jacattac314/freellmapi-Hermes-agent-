# ============================================================
#  Free LLM API Router — Environment Configuration
#  Copy this file to .env and fill in your keys.
#  NEVER commit .env to version control.
# ============================================================

# --- Service settings ---
PORT=3001
NODE_ENV=development

# Optional: protect /v1 endpoints with a bearer token.
# If not set, the /v1 API is open (fine for local use).
# FREE_LLM_API_KEY=your-secret-local-key

# --- Security ---
# Required for encrypted key storage via the dashboard.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Provider API Keys (env-var fallback) ---
# Keys set here work as a fallback when no DB key exists for a provider.
# For multi-key rotation, add keys via the dashboard (/keys page) instead.
# All providers are optional; the router skips unconfigured ones.

# Fast inference
GROQ_API_KEY=          # console.groq.com — generous free limits
CEREBRAS_API_KEY=      # inference.cerebras.ai — fastest free inference
SAMBANOVA_API_KEY=     # cloud.sambanova.ai — fast Llama models

# Multi-model aggregators
OPENROUTER_API_KEY=    # openrouter.ai — hundreds of models, :free suffix = free

# Major providers
MISTRAL_API_KEY=       # console.mistral.ai
GEMINI_API_KEY=        # aistudio.google.com — 15 RPM / 1M TPD free
COHERE_API_KEY=        # cohere.com — ~33 RPD free
NVIDIA_API_KEY=        # build.nvidia.com — 1000 free calls per model

# Developer-tier
GITHUB_TOKEN=          # github.com → Settings → Developer settings → PAT
TOGETHER_API_KEY=      # api.together.ai — $1 free credit
FIREWORKS_API_KEY=     # fireworks.ai — fast open-model inference
HF_TOKEN=              # huggingface.co — Serverless Inference ~60 RPH

# Self-hosted / edge
CLOUDFLARE_API_TOKEN=  # dash.cloudflare.com — 10k neurons/day free
CLOUDFLARE_ACCOUNT_ID=
# OLLAMA_BASE_URL=http://localhost:11434  # local Ollama instance

# --- Router settings ---
# Request timeout in milliseconds per provider attempt
PROVIDER_TIMEOUT_MS=30000

# --- Dashboard ---
# Port for the Vite dev server (frontend)
DASHBOARD_PORT=3000
