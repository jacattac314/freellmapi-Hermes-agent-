# ============================================================
#  Free LLM API Router — Environment Configuration
#  Copy this file to .env and fill in your keys.
#  NEVER commit .env to version control.
# ============================================================

# --- Service settings ---
PORT=3001
NODE_ENV=development

# Optional: protect /v1 endpoints with a bearer token.
# If not set, the /v1 API is open (fine for local use).
# FREE_LLM_API_KEY=your-secret-local-key

# --- Provider API Keys ---
# Only add keys for providers you want to use.
# All providers are optional; the router skips unconfigured ones.

# OpenRouter (https://openrouter.ai) - free models available
OPENROUTER_API_KEY=

# Groq (https://console.groq.com) - free tier with generous limits
GROQ_API_KEY=

# Mistral (https://console.mistral.ai)
MISTRAL_API_KEY=

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=

# GitHub Models (https://github.com/marketplace/models)
GITHUB_TOKEN=

# Cloudflare Workers AI (https://dash.cloudflare.com)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Router settings ---
# Request timeout in milliseconds per provider attempt
PROVIDER_TIMEOUT_MS=30000

# How long (ms) to keep a provider in cooldown after a failure
PROVIDER_COOLDOWN_MS=60000

# --- Dashboard ---
# Port for the Vite dev server (frontend)
DASHBOARD_PORT=3000
